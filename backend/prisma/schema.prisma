generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
}

model Otp {
  id        String     @id @default(uuid())
  userId    String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  consumed  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerified    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)

  otps                Otp[]
  passwordResetTokens PasswordResetToken[]

  teams        TeamMember[]
  submissions  Submission[]
  ownedEvents  Event[]       @relation("EventOwner")
  eventMembers EventMember[]
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  ownerId     String

  owner      User          @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teams      Team[]
  challenges Challenge[]
  members    EventMember[]
  teamMembers TeamMember[]


  @@index([ownerId])
}

model Team {
  id           String   @id @default(uuid())
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  eventId      String
  teamPassword String

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  members TeamMember[]
  submissions Submission[]

  @@unique([eventId, name])
  @@index([eventId])
}

model EventMember {
  id        String    @id @default(uuid())
  role      EventRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  eventId   String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model TeamMember {
  id        String   @id @default(uuid())
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  teamId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@unique([userId, eventId])
  @@index([userId])
  @@index([teamId])
  @@index([eventId])
}
enum ChallengeCategory {
  WEB
  CRYPTO
  PWN
  REVERSE
  FORENSICS
  OSINT
  MISC
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Challenge {
  id          String              @id @default(uuid())
  title       String
  description String
  flag        String
  points      Int                 @default(100)
  category    ChallengeCategory
  difficulty  ChallengeDifficulty
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  eventId     String

  hasFile Boolean @default(false)
  fileUrl String?

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submissions Submission[]

  @@index([eventId])
}

model Submission {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  challengeId String
  teamId      String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([challengeId, teamId])
  @@index([userId])
  @@index([challengeId])
  @@index([teamId])
}
